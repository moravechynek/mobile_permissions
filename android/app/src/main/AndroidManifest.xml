<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Runtime ("dangerous") permissions: the user is asked at first use. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Step counter, Android 10+. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Bluetooth: Android 12+ "Nearby devices" runtime permissions, before that normal ones. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Notifications: runtime permission since Android 13, before that allowed by default. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Normal permissions: granted at install time, the user is never asked. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Storage / media. Which permission applies depends on the Android version:
        <= 12 (API 32): READ_EXTERNAL_STORAGE gives access to all shared files.
        13 (API 33):    split into READ_MEDIA_IMAGES / _VIDEO / _AUDIO, other files only via the system picker.
        14+ (API 34):   the user may grant only selected photos (READ_MEDIA_VISUAL_USER_SELECTED).
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
      DEMO: "All files access" (Android 11+). Not a runtime prompt: the user has to enable it in
      Settings -> Special app access. Google Play allows it only for file managers, backup apps, etc.
    -->
    <!-- <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" /> -->

    <!--
      DEMO: package visibility (Android 11+).
      This app sees only system apps + the packages listed in <queries> below.
      The "queryAll" flavor (src/queryAll/AndroidManifest.xml) adds QUERY_ALL_PACKAGES and sees EVERY installed app:
      install both APKs and compare the "Nainstalované aplikace" card.
    -->

    <queries>
        <!-- Specific apps we are allowed to "see" without QUERY_ALL_PACKAGES. -->
        <package android:name="com.whatsapp" />
        <!-- Any app that can open web links (browsers). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
